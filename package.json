{
  "name": "@seethruhead/wish-farm-planner",
  "version": "0.1.2",
  "description": "Plan your discretionary spending with a YNAB-style wish farm. Uses CRA payroll data to determine true disposable income.",
  "type": "module",
  "bin": {
    "wish-farm-planner": "dist/wish-farm-planner.js"
  },
  "files": [
    "dist/wish-farm-planner.js"
  ],
  "scripts": {
    "dev": "bun run src/main.ts",
    "build": "bun build src/main.ts --outfile dist/wish-farm-planner.js --target=node --minify",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "release": "bash release.sh"
  },
  "keywords": [
    "ynab",
    "wish-farm",
    "budget",
    "planner",
    "discretionary",
    "spending",
    "cra",
    "payroll",
    "canada"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@effect/cli": "^0.73.2",
    "@effect/platform": "^0.94.4",
    "@effect/platform-node": "^0.104.1",
    "cli-table3": "^0.6.5",
    "effect": "^3.19.16"
  },
  "devDependencies": {
    "@types/bun": "^1.3.9",
    "typescript": "^5.9.3"
  }
}
